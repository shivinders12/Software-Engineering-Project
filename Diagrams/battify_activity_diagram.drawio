<mxfile host="app.diagrams.net">
  <diagram name="Battify - Activity Diagram" id="activityDiagram1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="390" y="20" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Customer selects battery, capacity, vehicle/application &amp; preferred brand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="System validates request &amp; checks inventory availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="In stock nearby?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Notify customer - Out of Stock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="645" y="420" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="Customer selects delivery location &amp; preferred service slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="430" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Order created &amp; assigned a unique Order ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="540" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="Operations dashboard assigns order to delivery/installation agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="630" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="Agent verifies/collects old battery, delivers &amp; installs new battery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="730" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="Old battery recorded for buyback / recycling handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="840" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="System calculates buyback credit &amp; final invoice amount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="930" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="Order marked Completed; customer notified with final status &amp; invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="1030" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n13" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="390" y="1130" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
